# EC2/Node で動かすときの環境変数。このファイルをコピーして .env を作り、値を入れる。
# .env は .gitignore 済み（コミットしないこと）。
# ※ EC2 に IAM ロールを付ける場合、AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY は不要
#   （aws4fetch は明示キーが要るため、その場合は別途対応が必要。まずはキー方式で動かすのが簡単）

# --- サーバー ---
PORT=8787
# フロント(dist)を同一サーバーで配信する場合のパス（既定: ../web/dist）
WEB_DIST=../web/dist
# 定期収集の間隔（cron書式）。既定は6時間ごと
CRON_SCHEDULE=0 */6 * * *
# cron を止めたいとき 1
# DISABLE_CRON=1

# --- AWS 認証 ---
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI (Bedrock GLM-5) ---
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=zai.glm-5

# --- PostgreSQL（必須）---
# サーバーPCに立てた Postgres の接続文字列。起動時にテーブルは自動作成される。
# 例(ローカル): postgres://events:password@localhost:5432/events
# マネージド等でSSLが要る場合は DB_SSL=true か、末尾に ?sslmode=require を付ける。
DATABASE_URL=
# DB_SSL=true

# --- テーブル名（この名前で Postgres にテーブルを作る）---
PROFILES_TABLE=prefecture-events-ai-profiles
EVENTS_TABLE=prefecture-events-ai-events
SUBSCRIPTIONS_TABLE=prefecture-events-ai-subscriptions
SOURCES_TABLE=prefecture-events-ai-sources

# --- その他 ---
EVENT_SOURCES_JSON=[]
VAPID_SUBJECT=mailto:admin@example.com

# --- 管理画面トークン（本番は必ず設定） ---
ADMIN_TOKEN=
