{
  "name": "@prefecture-events-ai/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.609.0",
    "@aws-sdk/client-dynamodb": "^3.609.0",
    "@aws-sdk/client-lambda": "^3.609.0",
    "@aws-sdk/client-secrets-manager": "^3.609.0",
    "@aws-sdk/lib-dynamodb": "^3.609.0",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.9.3",
    "openai": "^6.14.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/web-push": "^3.6.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.2"
  }
}
